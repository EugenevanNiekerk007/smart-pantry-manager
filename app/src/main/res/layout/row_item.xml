<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/panel"
    android:padding="16dp" android:layout_marginBottom="8dp">
    <TextView android:id="@+id/rowTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/ink"
        android:textSize="17sp" android:textStyle="bold" />
    <TextView android:id="@+id/rowSubtitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/muted"
        android:paddingTop="5dp" android:textSize="14sp" />
</LinearLayout>
